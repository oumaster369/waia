{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waia-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "waia-app",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://waia.life",
    "OAUTH_PUBLIC_BASE_URL": "https://waia.life",
    "WAIA_DB_BACKEND": "postgres",
    "WAIA_AI_GATEWAY_FOUNDATION": "1",
    "WAIA_AI_PROVIDER": "openai-compatible",
    "WAIA_AI_OPENAI_MODEL": "gpt-5.5",
    "WAIA_AI_OPENAI_TEMPERATURE": "0",
    "WAIA_AI_OPENAI_PARSE_DIAGNOSTICS": "0",
    "WAIA_TWIN_DIALOGUE_CONTINUITY": "replay_v1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://wdsnuvldxyrkqcjxvuxp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_wXZ5eaR4l6UKYXQMxr4fuw_cxz-Kk58",
  },
}
