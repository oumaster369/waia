{
  "name": "waia-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:postgres": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:postgres:up": "docker compose -f docker-compose.postgres-validate.yml up -d --wait",
    "db:postgres:down": "docker compose -f docker-compose.postgres-validate.yml down",
    "db:postgres:auth-prelude": "tsx scripts/postgres-validation/apply-auth-prelude.ts",
    "db:postgres:bootstrap": "pnpm db:postgres:up && pnpm db:postgres:auth-prelude && pnpm db:migrate:postgres",
    "db:smoke:postgres": "WAIA_POSTGRES_CLI=1 tsx scripts/postgres-validation/drizzle-pg-smoke.ts",
    "waia:core:backfill": "WAIA_POSTGRES_CLI=1 node --import tsx --conditions=react-server scripts/waia-core/backfill.ts",
    "trader:paper:loop": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/paper-bar-close-loop.ts",
    "trader:replay:build-dataset": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/build-dee-337-replay-dataset.ts",
    "trader:replay:seed-org": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/seed-paper-replay-org.ts",
    "trader:paper:soak:analyze": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/analyze-paper-soak-log.ts",
    "trader:paper:soak:evidence": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/export-paper-strategy-evidence.ts",
    "trader:gate": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/strategy-gate-cli.ts",
    "trader:htx:backfill": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/htx-kline-backfill.ts",
    "trader:research:pipeline": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/research-pipeline-cli.ts",
    "trader:ri:campaign": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/ri-evidence-campaign.ts",
    "trader:see:reconstruct-failure": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/reconstruct-research-failure.ts",
    "trader:see:reason": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/market-reasoning-assist.ts",
    "trader:paper:export": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/export-paper-evaluation.ts",
    "trader:live:request": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts request",
    "trader:live:confirm": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts confirm",
    "trader:live:enable": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts mark-enabled",
    "trader:live:disable": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts disable",
    "trader:live:status": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts status",
    "trader:live:cycle": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/live-cli.ts cycle",
    "trader:alert:drill": "WAIA_TRADER_CLI=1 node --import tsx --conditions=react-server scripts/trader/alert-drill-cli.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:pr-governance": "bash scripts/linear/test-validate-pr-linear-id.sh && bash scripts/linear/test-preflight-pr-governance.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.41.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.6",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wrangler": "^4.87.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
