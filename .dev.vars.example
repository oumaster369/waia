# Copy to `.dev.vars` in the `waia-app/` root for `pnpm cloudflare:preview` / Wrangler local Workers dev.
# `.dev.vars` is gitignored — never commit production secrets here.
#
# Legend: PUBLIC = safe for NEXT_PUBLIC_* in Workers; SECRET = server-only (Wrangler secrets in production).
#
# Reference: https://developers.cloudflare.com/workers/testing/local-development/
# Full inventory: docs/cloudflare-env-vars.md
# Operator runbook: docs/supabase-auth-postgres.md

# OpenNext / Next env file selection for local Workers preview (optional)
NEXTJS_ENV=development

# PUBLIC — match the origin you open in the browser for preview
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# PUBLIC — planned Supabase project URL (placeholder until SSR / client wiring exists).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# PUBLIC — Supabase anon key for future browser-safe usage (placeholder).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — MUST NEVER be exposed to browser/client code. Worker-only in production (`wrangler secret put`).
# SUPABASE_SERVICE_ROLE_KEY=

# PUBLIC — OAuth redirect base for existing MVP routes (OAuth itself out of scope for DEE-61).
OAUTH_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Local SQLite string for Node `pnpm dev` / legacy paths. Workers cannot run better-sqlite3 (see docs/cloudflare-deploy.md).
DATABASE_URL=file:./.data/waia.dev.db

# ─── Postgres runtime on Workers (DEE-74) — matches db/runtime-backend.ts + db/postgres-client.ts ───
# When set to postgres, getWaiaRuntimeDb() uses DATABASE_URL_POSTGRES only (never opens SQLite on that path).
# WAIA_DB_BACKEND=postgres
#
# SECRET — Supabase **transaction pooler** URI (recommended first path for Workers; often host …pooler.supabase.com, port 6543).
# Paste from Supabase Dashboard → Connect → Transaction pooler. Use `wrangler secret put` in production.
# DATABASE_URL_POSTGRES=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Optional later hardening: Cloudflare **Hyperdrive** in front of Postgres — not required for DEE-74; same env contract (connection string) once wired.

# SECRET — direct OpenAI API. MUST NOT ship to browser/client bundles.
# OPENAI_API_KEY=

# Optional: session TTL in seconds (omit for default)
# AUTH_SESSION_MAX_AGE_SECONDS=

# ─── AI-TRADER master key (DEE-220 / DEE-221) — local Workers preview ONLY ───
# SECRET — 256-bit AES key base64 (`openssl rand -base64 32`). Never production key.
# Production: Cloudflare Secrets Store binding AI_TRADER_MASTER_KEY (credential crypto fail-closed).
# AI_TRADER_MASTER_KEY_DEV=
# AI_TRADER_MASTER_KEY_MODE=dev
# WAIA_DEPLOYMENT_TIER=local

# ─── Payment Watcher (AT-E12 S3-A / DEE-321) ───
# TRONGRID_API_KEY=
# TRON_RPC_PRIMARY_URL=
# TRON_RPC_SECONDARY_URL=
# TRON_RPC_SECONDARY_API_KEY=
# WATCHER_ENABLED=
# WATCHER_CONFIRMATIONS_REQUIRED=
# WATCHER_RESCAN_WINDOW=

# ─── AI-TRADER alerting (DEE-223 / BP-9) — dedicated Alerts Bot only ───
# SECRET — never reuse TELEGRAM_BOT_TOKEN (OAuth). Production: wrangler secret put.
# TELEGRAM_ALERTS_BOT_TOKEN=
# TELEGRAM_ALERTS_CHAT_ID=
# TELEGRAM_ALERTS_THREAD_ID=
