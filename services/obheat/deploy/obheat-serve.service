[Unit]
Description=obheat order-book heatmap server
After=network-online.target obheat-collect.service

[Service]
Type=simple
WorkingDirectory=/opt/obheat
EnvironmentFile=-/etc/obheat.env
ExecStart=/opt/obheat/.venv/bin/python -m obheat.serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
