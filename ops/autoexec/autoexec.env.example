# Скопировать в /workspace/committee/exec/autoexec.env и подставить снаружи репозитория.
# В git не класть заполненный файл.

HTX_SMALL_API_KEY=
HTX_SMALL_API_SECRET=
# основной счёт, пока enabled=false в конфиге
HTX_API_KEY=
HTX_API_SECRET=

# необязательно: POST каждой строки журнала
AUTOEXEC_WEBHOOK_URL=

# 0 — бумага, 1 — цикл скрипта передаёт --live
AUTOEXEC_LIVE=0
AUTOEXEC_ACCOUNT=small
AUTOEXEC_ROOT=/workspace/committee/exec
AUTOEXEC_CONFIG=/workspace/committee/exec/autoexec.json
