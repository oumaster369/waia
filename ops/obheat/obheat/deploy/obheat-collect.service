[Unit]
Description=OB-HEATMAP collector (Binance, Bybit, OKX, HTX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obheat
Group=obheat
EnvironmentFile=-/etc/obheat.env
Environment=PYTHONPATH=/opt/obheat/app
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/srv/obheat
ExecStart=/opt/obheat/venv/bin/python -m obheat.collect
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/obheat
PrivateTmp=true

[Install]
WantedBy=multi-user.target
