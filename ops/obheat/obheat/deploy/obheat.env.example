# Каталог данных. Не пересекается с waia-binance.
OBHEAT_DATA=/srv/obheat
# Слушать только localhost. Для 0.0.0.0 обязателен OBHEAT_TOKEN.
OBHEAT_BIND=127.0.0.1
OBHEAT_PORT=8790
OBHEAT_TOKEN=
OBHEAT_LOG_LEVEL=INFO
OBHEAT_SYMBOLS=BTCUSDT,ETHUSDT
OBHEAT_VENUES=BINANCE,BYBIT,OKX,HTX,BITGET,GATE,BINANCE_SPOT,COINBASE,OKX_SPOT,BYBIT_SPOT
