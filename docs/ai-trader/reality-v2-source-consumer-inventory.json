      "lib/trader/execution/v2/reality-adapter.ts",
      "lib/trader/mi/raw-capture-v1.ts",
      "lib/trader/mi/raw-capture-repository-postgres.ts",
      "lib/trader/balances/sync-handler.ts",
      "lib/trader/trade-history/sync-handler.ts",
      "lib/trader/positions/sync-handler.ts",
      "lib/trader/market-brain/htx-ingestion.ts",
      "lib/trader/live/live-connector.ts",
