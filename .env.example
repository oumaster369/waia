# Copy this file to `.env.local` and fill in real values.
# `.env*` files are gitignored — never commit secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Legend (DEE-61)
#   PUBLIC   — safe for browser bundles when prefixed with NEXT_PUBLIC_* (still avoid leaking URLs you treat as private).
#   SECRET   — server-only. Never expose in client bundles, NEXT_PUBLIC_*, or client-side fetch bodies.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC — site origin (Open Graph, sitemap, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase Auth (planned; wire-up is tracked outside this template-only issue) ───

# PUBLIC — anon / publishable key for future browser-safe Supabase client usage.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses Row Level Security; full privilege via Supabase.
# MUST NEVER be bundled for the browser or prefixed with NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Database ───

# SQLite URL for current local MVP (`pnpm db:migrate` before first read).
# Runtime migration from SQLite to Postgres is tracked separately — not all tools accept both shapes yet.
DATABASE_URL=file:./.data/waia.db

# D6-pre — Postgres driver URL for Drizzle Postgres config, `postgres-client`, smoke script, and opt-in integration tests.
# Does NOT switch the app to Postgres; production remains SQLite unless you explicitly set WAIA_DB_BACKEND (still guarded).
# Local Docker (see docs/postgres-development.md):
# DATABASE_URL_POSTGRES=postgresql://waia_validate:waia_validate_local_only@127.0.0.1:54329/waia_validate
# Optional: postgres.js prepared statements (default off — required off for Supabase transaction pooler / Workers).
# WAIA_POSTGRES_PREPARE_STATEMENTS=true
#
# DEE-110 — When WAIA_DB_BACKEND=postgres: default is one postgres.js client per request (Workers-safe).
# Set to false / 0 / no / off for emergency rollback to the legacy in-worker singleton (known unstable on Workers).
# WAIA_POSTGRES_PER_REQUEST_CLIENT=false
# Optional: set to "1" to run tests/integration postgres guard tests alongside unit tests.
# WAIA_PG_INTEGRATION=1

# ─── Twin / readiness (bounded v1 demo writer) ───
# Opt-in: after a successful (non-replayed) Twin dialogue turn, may advance the lowest indicator
# one monotonic stage (0→33→67→100) when message heuristics match. Default off. Replaced by DEE-37 later.
# WAIA_READINESS_WRITER=1

# SECRET — direct Postgres URI (Supabase Dashboard → Database → connection string).
# Typical for local Node `pnpm dev`, migrations, and CLI when Drizzle targets Postgres.
# Uncomment and use *instead of* the SQLite line above when your environment is on Postgres.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session cookie TTL in seconds (default in code: 30 days if unset)
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# OAuth callbacks (authorize redirect_uri origin). Overrides NEXT_PUBLIC_SITE_URL when both are set.
# OAuth provider configuration is outside DEE-61 scope — placeholders retained for existing MVP routes.
OAUTH_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (authorize + confidential token exchange + userinfo)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple Sign In (Services ID client + ES256 JWT client_secret materials)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"

# Telegram Login (BOT_ID:BOTTOKEN from BotFather; bot id is token prefix before ':' )
# TELEGRAM_BOT_TOKEN=

# ─── AI Gateway foundation (DEE-77) ───
# Opt-in: routes Twin dialogue assistant text through CompletionProviderPort + FakeCompletionProvider (no network).
# Unset / 0 / false / no / off — legacy inline stub path (default MVP behavior).
# WAIA_AI_GATEWAY_FOUNDATION=1

# ─── AI Gateway network provider (DEE-78) — requires WAIA_AI_GATEWAY_FOUNDATION; default stays non-network ───
# Provider id allowlist: unset → fake; unknown values → fake. Only openai-compatible may egress.
# WAIA_AI_PROVIDER=fake
# WAIA_AI_PROVIDER=openai-compatible
#
# OpenAI-compatible HTTPS (fetch POST {base}/v1/chat/completions). Namespace WAIA_AI_* — do not reuse OPENAI_API_KEY here.
# WAIA_AI_OPENAI_API_KEY=
# WAIA_AI_OPENAI_BASE_URL=https://api.openai.com
# WAIA_AI_OPENAI_MODEL=gpt-4o-mini
# Twin dialogue sampling only (DEE-126). Unset or invalid → 0. Clamped to [0, 2].
# For gpt-5* / o1* / o3* / o4* Chat Completions, the provider omits `temperature` in the API body (400 unsupported_value).
# WAIA_AI_OPENAI_TEMPERATURE=0
# WAIA_AI_OPENAI_REQUEST_TIMEOUT_MS=15000
#
# Reasoning models (gpt-5*, o1/o3/o4): Chat Completions uses max_completion_tokens (reasoning + visible).
# Floor defaults to 4096 when the caller passes a smaller maxOutputTokens (Twin uses 256). Override if needed.
# WAIA_AI_OPENAI_REASONING_MIN_COMPLETION_TOKENS=4096
#
# Worker logs: JSON line with assistant parse shape when HTTP 200 but assistant text cannot be extracted (no message bodies).
# WAIA_AI_OPENAI_PARSE_DIAGNOSTICS=1

# ─── Twin dialogue bounded continuity replay (DEE-109 Slice 1) ───
# Requires WAIA_AI_GATEWAY_FOUNDATION (and a provider) active — standby mode skips DB replay when foundation off.
# Unset — no replay; same envelope as legacy single-turn MVP.
# Allowed truthy tokens: 1/true/yes/on/replay/replay_v1
# WAIA_TWIN_DIALOGUE_CONTINUITY=replay_v1

# ─── OpenAI (deferred — legacy/other tooling; Twin gateway uses WAIA_AI_OPENAI_* per DEE-78) ───

# SECRET — server-side API calls only. MUST NOT appear in browser or other client code.
# OPENAI_API_KEY=
