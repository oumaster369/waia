# Copy this file to `.env.local` and fill in real values.
# `.env*` files are gitignored — never commit secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Legend (DEE-61)
#   PUBLIC   — safe for browser bundles when prefixed with NEXT_PUBLIC_* (still avoid leaking URLs you treat as private).
#   SECRET   — server-only. Never expose in client bundles, NEXT_PUBLIC_*, or client-side fetch bodies.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC — site origin (Open Graph, sitemap, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Module host routing (AT-E1 S2) ───
# PUBLIC — trader portal origin (dedicated module entry)
# NEXT_PUBLIC_TRADER_URL=http://trader.localhost:3000
# Server-side host matching (defaults derived from URLs above when unset)
# WAIA_PRIMARY_HOST=localhost
# WAIA_TRADER_HOST=trader.localhost
# OPTIONAL production-only reversible UX enhancement — NOT required for M2, NOT the SSO strategy.
# Leave unset locally; enables seamless *.waia.life session sharing when intentionally enabled in prod.
# WAIA_COOKIE_DOMAIN=.waia.life
# Kill-switch for trader-host topology middleware (default on when unset)
# WAIA_TRADER_HOST_ROUTING=1

# ─── Supabase Auth (planned; wire-up is tracked outside this template-only issue) ───

# PUBLIC — anon / publishable key for future browser-safe Supabase client usage.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses Row Level Security; full privilege via Supabase.
# MUST NEVER be bundled for the browser or prefixed with NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Database ───

# SQLite URL for current local MVP (`pnpm db:migrate` before first read).
# Runtime migration from SQLite to Postgres is tracked separately — not all tools accept both shapes yet.
DATABASE_URL=file:./.data/waia.db

# D6-pre — Postgres driver URL for Drizzle Postgres config (`pnpm db:migrate:postgres` / `db:generate:postgres` load `.env` + `.env.local` when not exported), `postgres-client`, smoke script, and opt-in integration tests.
# Does NOT switch the app to Postgres; production remains SQLite unless you explicitly set WAIA_DB_BACKEND (still guarded).
# Local Docker (see docs/postgres-development.md):
# DATABASE_URL_POSTGRES=postgresql://waia_validate:waia_validate_local_only@127.0.0.1:54329/waia_validate
# Optional: postgres.js prepared statements (default off — required off for Supabase transaction pooler / Workers).
# WAIA_POSTGRES_PREPARE_STATEMENTS=true
#
# DEE-110 — When WAIA_DB_BACKEND=postgres: default is one postgres.js client per request (Workers-safe).
# Set to false / 0 / no / off for emergency rollback to the legacy in-worker singleton (known unstable on Workers).
# WAIA_POSTGRES_PER_REQUEST_CLIENT=false
# Optional: set to "1" to run tests/integration postgres guard tests alongside unit tests.
# WAIA_PG_INTEGRATION=1
#
# DEE-399 — long-running CLI campaigns only (e.g. `pnpm trader:m9:campaign`), NOT the Workers
# runtime path. A multi-hour single-connection process must not hold the Supabase transaction
# pooler (:6543) — it recycles held connections, observed as a mid-write CAMPAIGN_CRASH. Prefer
# the session-mode pooler (same host, port 5432) or a direct connection (db.[ref].supabase.co:5432).
# Falls back to DATABASE_URL_POSTGRES with a console warning if unset.
# DATABASE_URL_POSTGRES_SESSION=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── WAIA Core (M1 shadow mode) ───
# Entitlement/permission enforcement off by default in M1 (shadow logging only).
# WAIA_CORE_ENFORCEMENT=1
# WAIA_CORE_SHADOW=0

# ─── Twin / readiness (bounded v1 demo writer) ───
# Opt-in: after a successful (non-replayed) Twin dialogue turn, may advance the lowest indicator
# one monotonic stage (0→33→67→100) when message heuristics match. Default off. Replaced by DEE-37 later.
# WAIA_READINESS_WRITER=1

# SECRET — direct Postgres URI (Supabase Dashboard → Database → connection string).
# Typical for local Node `pnpm dev`, migrations, and CLI when Drizzle targets Postgres.
# Uncomment and use *instead of* the SQLite line above when your environment is on Postgres.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session cookie TTL in seconds (default in code: 30 days if unset)
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# OAuth callbacks (authorize redirect_uri origin). Overrides NEXT_PUBLIC_SITE_URL when both are set.
# OAuth provider configuration is outside DEE-61 scope — placeholders retained for existing MVP routes.
OAUTH_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (authorize + confidential token exchange + userinfo)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple Sign In (Services ID client + ES256 JWT client_secret materials)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"

# Telegram Login (BOT_ID:BOTTOKEN from BotFather; bot id is token prefix before ':' )
# TELEGRAM_BOT_TOKEN=

# ─── AI-TRADER alerting (DEE-223 / BP-9) — dedicated Alerts Bot only ───
# Do not reuse TELEGRAM_BOT_TOKEN for alerting.
# TELEGRAM_ALERTS_BOT_TOKEN=
# TELEGRAM_ALERTS_CHAT_ID=
# TELEGRAM_ALERTS_THREAD_ID=

# ─── AI Gateway foundation (DEE-77) ───
# Opt-in: routes Twin dialogue assistant text through CompletionProviderPort + FakeCompletionProvider (no network).
# Unset / 0 / false / no / off — legacy inline stub path (default MVP behavior).
# WAIA_AI_GATEWAY_FOUNDATION=1

# ─── AI Gateway network provider (DEE-78) — requires WAIA_AI_GATEWAY_FOUNDATION; default stays non-network ───
# Provider id allowlist: unset → fake; unknown values → fake. Only openai-compatible may egress.
# WAIA_AI_PROVIDER=fake
# WAIA_AI_PROVIDER=openai-compatible
#
# OpenAI-compatible HTTPS (fetch POST {base}/v1/chat/completions). Namespace WAIA_AI_* — do not reuse OPENAI_API_KEY here.
# WAIA_AI_OPENAI_API_KEY=
# WAIA_AI_OPENAI_BASE_URL=https://api.openai.com
# WAIA_AI_OPENAI_MODEL=gpt-4o-mini
# Twin dialogue sampling only (DEE-126). Unset or invalid → 0. Clamped to [0, 2].
# For gpt-5* / o1* / o3* / o4* Chat Completions, the provider omits `temperature` in the API body (400 unsupported_value).
# WAIA_AI_OPENAI_TEMPERATURE=0
# WAIA_AI_OPENAI_REQUEST_TIMEOUT_MS=15000
#
# Reasoning models (gpt-5*, o1/o3/o4): Chat Completions uses max_completion_tokens (reasoning + visible).
# Floor defaults to 4096 when the caller passes a smaller maxOutputTokens (Twin uses 256). Override if needed.
# WAIA_AI_OPENAI_REASONING_MIN_COMPLETION_TOKENS=4096
#
# Worker logs: JSON line with assistant parse shape when HTTP 200 but assistant text cannot be extracted (no message bodies).
# WAIA_AI_OPENAI_PARSE_DIAGNOSTICS=1

# ─── Twin dialogue bounded continuity replay (DEE-109 Slice 1) ───
# Requires WAIA_AI_GATEWAY_FOUNDATION (and a provider) active — standby mode skips DB replay when foundation off.
# Unset — no replay; same envelope as legacy single-turn MVP.
# Allowed truthy tokens: 1/true/yes/on/replay/replay_v1
# WAIA_TWIN_DIALOGUE_CONTINUITY=replay_v1

# ─── AI-TRADER Strategy Evolution reasoning (SEE-R1) — independent foundation profile ───
# Opt-in for trader market reasoning assist CLI (pnpm trader:see:reason). Default: fake provider (no secrets).
# WAIA_TRADER_SEE_AI_REASONING=1
# WAIA_AI_TRADER_GATEWAY_FOUNDATION=1
# WAIA_AI_TRADER_PROVIDER=fake
# WAIA_AI_TRADER_PROVIDER=openai-compatible
# WAIA_AI_TRADER_PROVIDER_LIFECYCLE=sandbox
# WAIA_AI_TRADER_PROVIDER_LIFECYCLE=production
#
# Separate from Twin — do NOT reuse WAIA_AI_OPENAI_API_KEY for trader reasoning.
# WAIA_AI_TRADER_OPENAI_API_KEY=
# WAIA_AI_TRADER_OPENAI_BASE_URL=https://api.openai.com
# WAIA_AI_TRADER_OPENAI_MODEL=gpt-4o-mini
# WAIA_AI_TRADER_OPENAI_TEMPERATURE=0
# WAIA_AI_TRADER_OPENAI_REQUEST_TIMEOUT_MS=15000
# WAIA_AI_TRADER_OPENAI_MAX_OUTPUT_TOKENS=2048
# WAIA_AI_TRADER_OPENAI_MAX_RETRIES=2
# WAIA_AI_TRADER_DAILY_TOKEN_BUDGET=
# WAIA_AI_TRADER_RATE_LIMIT_RPM=

# ─── OpenAI (deferred — legacy/other tooling; Twin gateway uses WAIA_AI_OPENAI_* per DEE-78) ───

# SECRET — server-side API calls only. MUST NOT appear in browser or other client code.
# OPENAI_API_KEY=

# ─── Linear (GitHub Actions only — do NOT commit) ───
# Repository secret LINEAR_API_KEY powers .github/workflows/linear-done.yml (DEE-NN → Done on merge).
# Create at: Linear → Settings → API → Personal API keys. Scope: issue read/write for team DEE.

# ─── AI-TRADER master key (DEE-220 / DEE-221) — local/test ONLY ───
# SECRET — 256-bit AES key as base64 (`openssl rand -base64 32`). Never use in production.
# Production master key lives in Cloudflare Secrets Store binding AI_TRADER_MASTER_KEY
# (see docs/ops/DEE-220-MASTER-KEY-RUNBOOK.md). Credential store/decrypt fail closed without it.
# AI_TRADER_MASTER_KEY_DEV=
# Force DevMasterKeyProvider locally (never set on production — factory throws MasterKeyConfigError).
# AI_TRADER_MASTER_KEY_MODE=dev
# Deployment tier signal for isProductionReady() — do not rely on NODE_ENV alone.
# WAIA_DEPLOYMENT_TIER=local

# ─── AI-TRADER FHV operations (DEE-416) — server-only ───
# SECRET — HMAC signing key for operator commands forwarded to the observer tunnel.
# FHV_OPERATOR_COMMAND_SECRET=
# SECRET — CSRF signing key for /admin/fhv-operations browser mutations.
# FHV_ADMIN_CSRF_SECRET=
# SECRET — HMAC auth for Worker ↔ observer tunnel transport.
# FHV_OBSERVER_TUNNEL_SECRET=
# SECRET — Observer tunnel base URL (production Worker runtime).
# FHV_OBSERVER_TUNNEL_BASE_URL=
# OPTIONAL — Observer tunnel fetch timeout in milliseconds.
# FHV_OBSERVER_TUNNEL_TIMEOUT_MS=10000
# LOCAL DEV ONLY — enable filesystem status adapter (never production).
# FHV_STATUS_ADAPTER=local_file
# LOCAL DEV ONLY — absolute path to fhv-operator-status.v1.json when using local_file adapter.
# FHV_OPERATOR_STATUS_PATH=
# Execution host observer daemon (localhost only).
# FHV_RUN_ROOT=
# FHV_RUN_ID=
# FHV_ORGANIZATION_ID=
# FHV_OBSERVER_PORT=9471

# ─── AI-TRADER execution host (DEE-339 / BP-6) — off-Cloudflare only ───
# Health-only scaffold in BP-6. No master key in image/env/git.
# Runtime secrets: operator-injected at deploy (separate KMS path — NOT Cloudflare Secrets Store).
# See docs/ops/DEE-339-BP6-EXECUTION-HOST-RUNBOOK.md and docs/ops/EXECUTION-SERVER-RUNBOOK.md
# EXECUTION_HOST_PORT=8080
# WAIA_TRADER_EXECUTION_HOST_URL=http://127.0.0.1:8080
#
# DEE-406 — Execution Server code pin + deployed revision (host operator only; not Workers runtime).
# Full 40-char git SHA the host checkout must match before build/deploy/campaign.
# Used by scripts/ops/execution-server-preflight.sh (read-only stale-code guard).
# EXECUTION_SERVER_TARGET_SHA=
# Path to deployed-revision.json on the execution host (default: ./deployed-revision.json).
# EXECUTION_SERVER_DEPLOYED_REVISION_PATH=./deployed-revision.json
# Optional override when preflight runs outside the default repo root.
# EXECUTION_SERVER_REPO_PATH=
#
# DEE-409 — guarded execution-server tooling (host operator only; scripts no-op without --confirm)
# EXECUTION_SERVER_CONTAINER_NAME=ai-trader-execution-host
# EXECUTION_SERVER_IMAGE_PREFIX=waia-execution-host
# EXECUTION_SERVER_HOST_PORT=8080

# ─── AI-TRADER Org-0 live path (DEE-212 / BP-7) — operator only ───
# Org-0 organization UUID allowlist (unset → live path fail-closed).
# WAIA_TRADER_ORG0_ORGANIZATION_ID=
# Optional org live-enable cooling-off override (ms).
# TRADER_ORG_LIVE_ENABLE_COOLING_OFF_MS=

# SECRET — TronGrid API key (Worker secret in production).
# TRONGRID_API_KEY=
# TRON_RPC_PRIMARY_URL=
# TRON_RPC_SECONDARY_URL=
# TRON_RPC_SECONDARY_API_KEY=
# WATCHER_ENABLED=
# WATCHER_CONFIRMATIONS_REQUIRED=
# WATCHER_RESCAN_WINDOW=
# WATCHER_MAX_BLOCKS_PER_CYCLE=
# WATCHER_LEASE_TTL_SECONDS=
# WATCHER_START_BLOCK=
# WATCHER_STALE_THRESHOLD_SECONDS=
# WATCHER_RPC_MAX_RETRIES=
# WATCHER_REORG_AGEOUT_MINUTES=
# WATCHER_CONFIRM_QUORUM=
# Optional USDT TRC-20 contract override for payment watcher.
# WATCHER_USDT_CONTRACT=

# ─── Treasury watcher (DEE-606 WP-3) — independent of payment WATCHER_ENABLED ───
# TREASURY_WATCHER_ENABLED=
# TREASURY_WATCHER_CONFIRMATIONS_REQUIRED=
# TREASURY_WATCHER_RESCAN_WINDOW=
# TREASURY_WATCHER_MAX_BLOCKS_PER_CYCLE=
# TREASURY_WATCHER_LEASE_TTL_SECONDS=
# TREASURY_WATCHER_STALE_THRESHOLD_SECONDS=
# TREASURY_WATCHER_RPC_MAX_RETRIES=
# TREASURY_WATCHER_REORG_AGEOUT_MINUTES=
# TREASURY_WATCHER_MAX_PAGES_PER_BLOCK=
# TREASURY_WATCHER_USDT_CONTRACT=
# TREASURY_WATCHER_TRON_PRIMARY_URL=
# TREASURY_WATCHER_TRON_SECONDARY_URL=
# TREASURY_WATCHER_TRONGRID_API_KEY=
# TREASURY_WATCHER_TRON_SECONDARY_API_KEY=

# ─── Market Brain worker (Pipeline P3 / DEE-197–202) ───
# SECRET — enables HTX ingestion + MSV/CDE cycle on Cloudflare Cron when set with org id.
# MARKET_BRAIN_ENABLED=
# MARKET_BRAIN_ORGANIZATION_ID=
# Optional HTX REST host override (default https://api.huobi.pro). Not an API key.
# HTX_REST_HOST=
# Optional CoinGecko rate-limit relief for global market stats (fail-soft when unset).
# COINGECKO_API_KEY=
# Opt-in live HTX candle integration smoke — test/CI only; never required for Repeat M9.
# WAIA_HTX_LIVE_SMOKE=

# ─── Full Market Data Source Integration (DEE-393) — optional MI providers ───
# SECRET — FRED macro series API key (free tier with registration). Fail-soft when unset.
# Registration: https://fredaccount.stlouisfed.org
# FRED_API_KEY=
# SECRET — Infura project credentials for EVM RPC blockchain stats (separate from bare INFURA_* names).
# Registration: https://app.infura.io
# AI_TRADER_INFURA_PROJECT_ID=
# AI_TRADER_INFURA_API_SECRET=
# SECRET — TronGrid key for AI-TRADER blockchain intelligence (NOT payment watcher TRONGRID_API_KEY).
# Registration: https://www.trongrid.io/dashboard/
# AI_TRADER_TRONGRID_API_KEY=
# SECRET — Optional GitHub token for protocol release rate limits (fail-soft when unset).
# AI_TRADER_GITHUB_TOKEN=
# SECRET — SEC EDGAR User-Agent string (policy-bound; required for regulatory filings adapter).
# AI_TRADER_SEC_EDGAR_USER_AGENT=YourOrgName contact@example.com
# Opt-in CME FedWatch probability adapter (unset/false = disabled).
# AI_TRADER_CME_FEDWATCH_ENABLED=

# ─── Paper loop worker (Pipeline P5 / NEW-8) ───
# Enables one mock paper cycle per Cron tick (multi-strategy dispatch + startup reconciliation).
# PAPER_LOOP_ENABLED=
# PAPER_LOOP_ORGANIZATION_ID=
# PAPER_LOOP_ACCOUNT_KEY=
# PAPER_LOOP_DEFAULT_QUANTITY=
# PAPER_LOOP_STARTING_BALANCE_USDT=
# PAPER_LOOP_DEFAULT_STOP_DISTANCE_PCT=
# PAPER_LOOP_CYCLE_ID_PREFIX=

# ─── Strategy Validation Gate (DEE-178 / DEE-277 operator runway) ───
# Cooling-off duration for promotion (ms). Unset => default 900000 (15 min). This is
# ambient governance config (ADR-0011), NOT a per-invocation operator override; the
# `pnpm trader:gate` CLI never accepts a cooling-off flag. Keep >= the default in prod.
# TRADER_PROMOTION_COOLING_OFF_MS=
# TRADER_INVOICE_ISSUANCE_COOLING_OFF_MS=
# TRADER_INVOICE_APPROVAL_VALIDITY_MS=
# WAIA_TRADER_CLI=1 is the safety gate for trader CLIs (set automatically by the
# `pnpm trader:gate` / `pnpm trader:paper:loop` scripts). Do not export it globally.

# ─── HTR-WP23 historical readiness preflight (DEE-415) ───
# Readiness preflight CLI: pnpm trader:htr:readiness:preflight -- --self-test
# Optional Postgres connection-identity check (local validate profile only):
# WAIA_HTR_VALIDATE_POSTGRES_CONNECTION=

# PR-2 Market Intelligence Core — reconstruction + hypothesis + conviction pipeline.
# Default OFF; when disabled the evaluation cycle is byte-identical to understanding → CDE.
# WAIA_MI_CORE_ENABLED=1
