# Copy this file to .env.local and fill in real values.
# .env* files are gitignored — never commit secrets.

# Public site origin (used in Open Graph, sitemap, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add your own keys below as the project grows, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SQLite URL for local MVP persistence (`pnpm db:migrate` before first read)
DATABASE_URL=file:./.data/waia.db
