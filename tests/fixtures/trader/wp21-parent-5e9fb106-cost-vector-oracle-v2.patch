@@ -0,0 +1,210 @@
+/**
+ * WP21 parent cost-vector oracle v1 — parent-worktree local only (B5 split-proof lane v2).
+ * Isolated deterministic parent-native CostModelV1 economics; no DB, network, or candidate imports.
+ */
+import { createHash } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import {
+  applyCostToFill,
+  COST_MODEL_VERSION_V1,
+  createCostModelV1,
+} from "@/lib/trader/execution/cost-model";
+import { canonicalJsonString } from "@/lib/trader/research/digest";
+import {
+  addDecimal,
+  divideDecimal,
+  multiplyDecimal,
+  subtractDecimal,
+} from "@/lib/trader/risk/numeric";
+
+export const WP21_PARENT_COST_VECTOR_ORACLE_SCHEMA =
+  "waia.trader.wp21.parent-cost-vector-oracle.v2" as const;
+
+export const WP21_PARENT_GIT_SHA = "5e9fb1061723614b22604aee86ee129e8f226616" as const;
+
+export const WP21_BOUND_VECTOR_FIXTURE_PATH =
+  "tests/fixtures/trader/wp21-g2-cost-vectors-v1.json" as const;
+
+const PARENT_FEES_BPS = "10" as const;
+const PARENT_SLIPPAGE_BPS = "5" as const;
+
+export type Wp21CostVectorInput = {
+  vectorId: string;
+  side: "buy" | "sell";
+  grossFillPrice: string;
+  quantity: string;
+};
+
+export type Wp21ParentCostVectorRow = {
+  vectorId: string;
+  side: "buy" | "sell";
+  grossFillPrice: string;
+  quantity: string;
+  adjustedPrice: string;
+  feeAmount: string;
+  slippageCost: string;
+  grossNotional: string;
+  netCashEffect: string;
+  parentCostModelVersion: typeof COST_MODEL_VERSION_V1;
+};
+
+export type Wp21ParentCostVectorOracleSemanticV2 = {
+  schemaVersion: typeof WP21_PARENT_COST_VECTOR_ORACLE_SCHEMA;
+  parentGitSha: typeof WP21_PARENT_GIT_SHA;
+  vectorFixturePath: typeof WP21_BOUND_VECTOR_FIXTURE_PATH;
+  vectorFixtureSha256: string;
+  parentFeesBps: typeof PARENT_FEES_BPS;
+  parentSlippageBps: typeof PARENT_SLIPPAGE_BPS;
+  vectorCount: number;
+  rows: Wp21ParentCostVectorRow[];
+  semanticResultDigest: string;
+};
+
+export type Wp21ParentCostVectorOracleProvenanceEnvelope = {
+  cliFixturePath: string;
+};
+
+export type Wp21ParentCostVectorOracleRunResult = {
+  semantic: Wp21ParentCostVectorOracleSemanticV2;
+  provenanceEnvelope?: Wp21ParentCostVectorOracleProvenanceEnvelope;
+};
+
+function sha256Utf8(value: string): string {
+  return createHash("sha256").update(value, "utf8").digest("hex");
+}
+
+function assertDecimalString(value: string, field: string): void {
+  if (!/^-?\d+(\.\d+)?$/.test(value.trim())) {
+    throw new Error(`WP21_PARENT_ORACLE_NON_DECIMAL:${field}`);
+  }
+}
+
+function computeSlippageCost(grossFillPrice: string, quantity: string): string {
+  const grossNotional = multiplyDecimal(grossFillPrice, quantity);
+  return multiplyDecimal(grossNotional, divideDecimal(PARENT_SLIPPAGE_BPS, "10000"));
+}
+
+function computeNetCashEffect(
+  side: "buy" | "sell",
+  grossNotional: string,
+  feeAmount: string,
+): string {
+  if (side === "buy") {
+    return subtractDecimal("0", addDecimal(grossNotional, feeAmount));
+  }
+  return subtractDecimal(grossNotional, feeAmount);
+}
+
+export function computeParentCostVectorRow(vector: Wp21CostVectorInput): Wp21ParentCostVectorRow {
+  assertDecimalString(vector.grossFillPrice, "grossFillPrice");
+  assertDecimalString(vector.quantity, "quantity");
+  const costModel = createCostModelV1(PARENT_FEES_BPS, PARENT_SLIPPAGE_BPS);
+  const { adjustedPrice, fee: feeAmount } = applyCostToFill(
+    vector.grossFillPrice,
+    vector.quantity,
+    vector.side,
+    costModel,
+  );
+  const grossNotional = multiplyDecimal(adjustedPrice, vector.quantity);
+  const slippageCost = computeSlippageCost(vector.grossFillPrice, vector.quantity);
+  const netCashEffect = computeNetCashEffect(vector.side, grossNotional, feeAmount);
+  return {
+    vectorId: vector.vectorId,
+    side: vector.side,
+    grossFillPrice: vector.grossFillPrice,
+    quantity: vector.quantity,
+    adjustedPrice,
+    feeAmount,
+    slippageCost,
+    grossNotional,
+    netCashEffect,
+    parentCostModelVersion: COST_MODEL_VERSION_V1,
+  };
+}
+
+type VectorFixture = {
+  schemaVersion: string;
+  vectors: Wp21CostVectorInput[];
+};
+
+export function loadCostVectorFixture(fixturePath: string, expectedSha256: string): VectorFixture {
+  const abs = path.isAbsolute(fixturePath) ? fixturePath : path.join(process.cwd(), fixturePath);
+  const raw = readFileSync(abs, "utf8");
+  const digest = sha256Utf8(raw);
+  if (digest !== expectedSha256) {
+    throw new Error("WP21_PARENT_ORACLE_VECTOR_FIXTURE_DIGEST_MISMATCH");
+  }
+  return JSON.parse(raw) as VectorFixture;
+}
+
+export function runParentCostVectorOracle(input: {
+  fixturePath: string;
+  fixtureSha256: string;
+  includeProvenance?: boolean;
+}): Wp21ParentCostVectorOracleRunResult {
+  const fixture = loadCostVectorFixture(input.fixturePath, input.fixtureSha256);
+  const rows = fixture.vectors.map((vector) => computeParentCostVectorRow(vector));
+  const semanticBody = {
+    schemaVersion: WP21_PARENT_COST_VECTOR_ORACLE_SCHEMA,
+    parentGitSha: WP21_PARENT_GIT_SHA,
+    vectorFixturePath: WP21_BOUND_VECTOR_FIXTURE_PATH,
+    vectorFixtureSha256: input.fixtureSha256,
+    parentFeesBps: PARENT_FEES_BPS,
+    parentSlippageBps: PARENT_SLIPPAGE_BPS,
+    vectorCount: rows.length,
+    rows,
+  };
+  const semantic: Wp21ParentCostVectorOracleSemanticV2 = {
+    ...semanticBody,
+    semanticResultDigest: sha256Utf8(canonicalJsonString(semanticBody)),
+  };
+  const result: Wp21ParentCostVectorOracleRunResult = { semantic };
+  if (input.includeProvenance) {
+    result.provenanceEnvelope = { cliFixturePath: input.fixturePath };
+  }
+  return result;
+}
+
+function parseCliArgs(argv: string[]): {
+  fixturePath: string;
+  fixtureSha256: string;
+  outPath: string;
+  includeProvenance: boolean;
+} {
+  const args = new Map<string, string>();
+  for (const arg of argv) {
+    if (!arg.startsWith("--")) continue;
+    const body = arg.slice(2);
+    const eq = body.indexOf("=");
+    if (eq === -1) args.set(body, "true");
+    else args.set(body.slice(0, eq), body.slice(eq + 1));
+  }
+  const fixturePath = args.get("fixture-path")?.trim();
+  const fixtureSha256 = args.get("fixture-sha256")?.trim();
+  const outPath = args.get("out")?.trim();
+  const includeProvenance = args.get("include-provenance") === "true";
+  if (!fixturePath || !fixtureSha256 || !outPath) {
+    throw new Error("WP21_PARENT_ORACLE_CLI_MISSING_REQUIRED_ARGS");
+  }
+  return { fixturePath, fixtureSha256, outPath, includeProvenance };
+}
+
+async function main() {
+  const cli = parseCliArgs(process.argv.slice(2));
+  const result = runParentCostVectorOracle(cli);
+  const output = cli.includeProvenance
+    ? { ...result.semantic, provenanceEnvelope: result.provenanceEnvelope }
+    : result.semantic;
+  writeFileSync(cli.outPath, `${JSON.stringify(output, null, 2)}\n`, "utf8");
+}
+
+if (process.env.WAIA_TRADER_CLI === "1") {
+  main().catch((err: unknown) => {
+    console.error(err instanceof Error ? err.message : err);
+    process.exitCode = 1;
+  });
+}
+
+export { main as runWp21ParentCostVectorOracleCli };
